#!/usr/bin/env bash
# =====================================================================
# pre-push — دروازه محلی پیش از رسیدن کد به GitHub
# =====================================================================
# چون در پلن Free روی مخزن خصوصی، نه Branch Protection در دسترس است و
# نه Push Protection، این هوک جای هر دو را می‌گیرد — و در واقع بهتر:
# راز قبل از اینکه اصلاً از این دستگاه خارج شود گرفته می‌شود، نه در سرور.
#
# نصب:  ops/install-hooks.sh
# عبور اضطراری:  git push --no-verify   (فقط وقتی واقعاً می‌دانید چه می‌کنید)
# =====================================================================
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[0;33m'; NC='\033[0m'
FAIL=0

echo "─── بررسی پیش از Push ───"

# ── ۱. جست‌وجوی راز ────────────────────────────────────────────────
echo "→ جست‌وجوی راز در فایل‌های ردیابی‌شده"

PATTERNS='github_pat_[A-Za-z0-9_]{22,}|gh[pousr]_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|(password|passwd|secret|token|api_?key|apikey)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}["'"'"']'

# استثنای نقطه‌ای: هش «مسیر + متن خط». مسیر داخل هش است، پس هر ورودی
# دقیقاً یک خط از یک فایل را آزاد می‌کند — نه پوشه، نه پسوند، نه الگو.
# راز واقعیِ تازه، هشِ دیگری دارد و همچنان Push را متوقف می‌کند.
# نبودِ فایل = هیچ استثنایی؛ یعنی خطا به‌سمت «مسدود کردن» می‌افتد.
ALLOWLIST='ops/secret-allowlist.txt'

HITS=$(git grep -InE "$PATTERNS" -- \
        ':!.env.example' ':!ops/hooks/pre-push' ':!docs/SECURITY.md' \
        ":!$ALLOWLIST" 2>/dev/null \
      | grep -v 'ci_only_not_a_real_secret' \
      | while IFS= read -r hit; do
          path=${hit%%:*}; rest=${hit#*:}; text=${rest#*:}
          digest=$(printf '%s\t%s' "$path" "$text" | sha256sum | cut -d' ' -f1)
          grep -qxF "$digest" "$ALLOWLIST" 2>/dev/null || printf '%s\n' "$hit"
        done || true)

if [ -n "$HITS" ]; then
  echo -e "${RED}✗ راز احتمالی پیدا شد — Push متوقف شد:${NC}"
  echo "$HITS" | head -20 | sed 's/^/    /'
  echo
  echo "  اگر واقعی است: فایل را پاک کنید، راز را Revoke کنید، و اگر"
  echo "  قبلاً کامیت شده تاریخچه را هم بازنویسی کنید (git filter-repo)."
  FAIL=1
else
  echo -e "  ${GRN}✓ چیزی پیدا نشد${NC}"
fi

# ── ۲. فایل‌هایی که هرگز نباید کامیت شوند ──────────────────────────
echo "→ بررسی فایل‌های ممنوع"
BANNED=$(git ls-files | grep -E '(^|/)\.env$|(^|/)\.env\.(local|production|prod)$|\.pem$|\.key$|\.p12$|\.pfx$|(^|/)id_rsa|\.dump$|\.sql\.gz$' || true)
if [ -n "$BANNED" ]; then
  echo -e "${RED}✗ فایل ممنوع در مخزن:${NC}"
  echo "$BANNED" | sed 's/^/    /'
  FAIL=1
else
  echo -e "  ${GRN}✓ پاک${NC}"
fi

# .npmrc پیش از این کاملاً ممنوع بود. ولی خطر واقعی، توکن داخل آن است
# نه خود فایل — و تنظیمات Workspace (مثل خاموش‌کردن اسکریپت نصب) جای
# دیگری ندارند. پس محتوا سنجیده می‌شود، نه نام فایل. این سخت‌گیرانه‌تر
# است: توکنی که در فایلی با نام دیگر پنهان شود هم گرفته می‌شود.
NPMRC_AUTH=$(git ls-files -- '*.npmrc' '.npmrc' 2>/dev/null | while read -r f; do
  [ -f "$f" ] && grep -InE '_authToken|_auth[[:space:]]*=|_password|//[^[:space:]]+/:_' "$f" | sed "s|^|$f:|"
done)
if [ -n "$NPMRC_AUTH" ]; then
  echo -e "${RED}✗ اطلاعات احراز هویت در .npmrc:${NC}"
  echo "$NPMRC_AUTH" | sed 's/^/    /'
  echo "  توکن رجیستری باید در محیط باشد، نه در مخزن."
  FAIL=1
fi

# ── ۳. بیت اجرای اسکریپت‌ها ────────────────────────────────────────
# روی ویندوز core.fileMode خاموش است، پس اسکریپت تازه با حالت 100644
# کامیت می‌شود. محلی کار می‌کند (چون با `bash x.sh` صدا می‌زنید) ولی در
# CI لینوکسی «Permission denied» می‌دهد — و این دقیقاً یک بار اتفاق افتاد.
echo "→ بررسی بیت اجرای اسکریپت‌ها"
NOEXEC=$(git ls-files -s -- '*.sh' 'ops/hooks/*' | awk '$1 !~ /^100755$/ {print $4}')
if [ -n "$NOEXEC" ]; then
  echo -e "${RED}✗ اسکریپت بدون بیت اجرا:${NC}"
  echo "$NOEXEC" | sed 's/^/    /'
  echo "  اصلاح:  git update-index --chmod=+x <فایل>"
  FAIL=1
else
  echo -e "  ${GRN}✓ همه اجراشدنی${NC}"
fi

# ── ۴. تست‌های مالی ────────────────────────────────────────────────
if [ -n "${DATABASE_URL:-}" ]; then
  echo "→ اجرای تست‌های مالی"
  if ./ops/db.sh test > /tmp/labelmod-pretest.log 2>&1; then
    echo -e "  ${GRN}✓ همه تست‌ها پاس${NC}"
  else
    echo -e "${RED}✗ تست‌ها رد شدند — Push متوقف شد${NC}"
    tail -25 /tmp/labelmod-pretest.log | sed 's/^/    /'
    FAIL=1
  fi
else
  echo -e "  ${YLW}⚠ DATABASE_URL ست نیست — تست‌ها اجرا نشدند${NC}"
  echo -e "  ${YLW}  برای این پروژه، Push بدون اجرای تست مالی توصیه نمی‌شود.${NC}"
fi

# ── ۵. لایه Node ───────────────────────────────────────────────────
# فقط اگر وابستگی‌ها نصب‌اند. کلون تازه‌ای که هنوز pnpm install نزده،
# نباید سر Push گیر کند — ولی باید بداند که این دروازه رد شد.
if [ -f package.json ]; then
  if [ -d node_modules ] && command -v pnpm >/dev/null 2>&1; then
    echo "→ بررسی تایپ و تست لایه API"
    if pnpm typecheck > /tmp/labelmod-node.log 2>&1 \
       && pnpm test >> /tmp/labelmod-node.log 2>&1; then
      echo -e "  ${GRN}✓ typecheck و تست پاس${NC}"
    else
      echo -e "${RED}✗ لایه API رد شد — Push متوقف شد${NC}"
      tail -25 /tmp/labelmod-node.log | sed 's/^/    /'
      FAIL=1
    fi

    # آسیب‌پذیری High همان چیزی است که CI رویش می‌شکند. بهتر است
    # اینجا بفهمیم تا بعد از Push.
    if ! pnpm audit --prod --audit-level high > /tmp/labelmod-audit.log 2>&1; then
      echo -e "${RED}✗ آسیب‌پذیری High یا بالاتر در وابستگی‌ها${NC}"
      grep -E 'Severity|vulnerabilities found' /tmp/labelmod-audit.log | sed 's/^/    /'
      FAIL=1
    else
      echo -e "  ${GRN}✓ بدون آسیب‌پذیری High${NC}"
    fi
  else
    echo -e "  ${YLW}⚠ node_modules نیست — لایه API بررسی نشد (pnpm install)${NC}"
  fi
fi

echo "─────────────────────────"
if [ $FAIL -ne 0 ]; then
  echo -e "${RED}Push لغو شد.${NC}"
  exit 1
fi
echo -e "${GRN}آماده Push${NC}"
exit 0
