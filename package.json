{
  "name": "labelmod-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint:fix": "eslint . --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ],
    "overrides": {
      "typescript-eslint>typescript": "6.0.3",
      "@typescript-eslint/parser>typescript": "6.0.3",
      "@typescript-eslint/typescript-estree>typescript": "6.0.3",
      "@typescript-eslint/utils>typescript": "6.0.3",
      "@typescript-eslint/type-utils>typescript": "6.0.3",
      "@typescript-eslint/eslint-plugin>typescript": "6.0.3",
      "@typescript-eslint/project-service>typescript": "6.0.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.0"
  }
}
