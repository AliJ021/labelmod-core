# نصب در CI با --frozen-lockfile (بند ۵ SECURITY.md). اینجا هم سخت‌گیر
# باشیم تا نصب محلی و CI از هم جدا نیفتند.
engine-strict=true
# اسکریپت نصب وابستگی‌ها به‌صورت پیش‌فرض اجرا نشود: بزرگ‌ترین رشد حمله
# زنجیره تأمین در ۲۰۲۶ از همین مسیر بوده.
enable-pre-post-scripts=false
# استثنای اسکریپت نصب در package.json → pnpm.onlyBuiltDependencies است،
# نه اینجا: یک فهرست مجازِ صریح و کامیت‌شده، تا افزودن هر استثنای تازه
# در Diff دیده شود.
