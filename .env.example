# =====================================================================
# پیکربندی محیط — کپی کنید به `.env` و پر کنید
# =====================================================================
# ⚠️ `.env` هرگز کامیت نمی‌شود (هوک pre-push جلویش را می‌گیرد).
# ⚠️ روی سرور: `chmod 600 .env` و مالکش کاربر سرویس باشد
#    (بند ۸ SECURITY.md).
# ---------------------------------------------------------------------

# ── پایگاه داده ──────────────────────────────────────────────────────
# رمز قوی و تصادفی. ساختنش:  openssl rand -base64 24 | tr -d '/+='
# ⚠️ فقط حروف و رقم بگذارید: این مقدار داخل یک URL می‌نشیند و کاراکتر
#    مثل @ یا : رشته اتصال را می‌شکند.
DB_PASSWORD=یک_رمز_قوی_اینجا

# نقش محدود برنامه. در نصب اول APP_DB_USER را labelmod نگه دارید؛ پس از
# `ops/deploy.sh roles` آن را به labelmod_app عوض کنید و دوباره up بزنید.
APP_DB_USER=labelmod
APP_DB_PASSWORD=

# فقط برای اجرای ابزارها از **میزبان** (ops/db.sh, pnpm test).
# سرویس‌های داخل Compose خودشان این را از docker-compose می‌گیرند و
# میزبانشان `db` است، نه `localhost`.
DATABASE_URL=postgres://labelmod:همان_رمز@localhost:5432/labelmod

# ── استقرار تولیدی (docker-compose.prod.yml) ─────────────────────────
# دامنه‌ای که گواهی برایش گرفته می‌شود. باید رکورد A/AAAA آن به همین
# سرور اشاره کند، وگرنه Let's Encrypt گواهی نمی‌دهد.
# ⚠️ یک دامنه برای هر دو (UI و API). کوکی نشست SameSite=Strict است؛
#    دو دامنه یعنی ورود کار نمی‌کند.
SITE_ADDRESS=shop.example.com
# ایمیل هشدار انقضای گواهی
ACME_EMAIL=admin@example.com

# ── اختیاری ──────────────────────────────────────────────────────────
TZ=Asia/Tehran
LOG_LEVEL=info
DB_POOL_MAX=10
# ساعت محلی کار شبانه. بستن دوره فروش سایت، و بکاپ.
CLOSE_HOUR=3
BACKUP_HOUR=4

# ── پیامک (Worker) ───────────────────────────────────────────────────
# ⚠️ **راز است، نه تنظیم.** انتخاب سرویس‌دهنده، شماره فرستنده و اینکه
#    اصلاً پیامک روشن باشد یا نه، همه در صفحه تنظیمات‌اند — چون
#    تصمیم‌اند و مقدارشان در لاگ حسابرسی می‌نشیند. کلید اینجاست چون
#    نباید هیچ‌جا دیده شود.
#
# خالی ماندنش مشکلی ندارد تا وقتی سرویس‌دهنده «log» باشد (پیش‌فرض):
# آن‌وقت هیچ پیامکی واقعاً نمی‌رود و متنش در لاگ Worker دیده می‌شود.
SMS_API_KEY=

# این سه به **ظرفیت ماشین** مربوطند، نه به کسب‌وکار. معمولاً دست‌نخورده
# می‌مانند.
WORKER_INTERVAL_MS=5000
WORKER_BATCH=20
# ⚠️ باید از بدترین زمان ارسال پیامک بلندتر باشد، وگرنه پیامی که هنوز
#    در حال رفتن است دوباره برداشته می‌شود و مشتری دو پیامک می‌گیرد.
WORKER_LEASE_SECONDS=120

# ── بکاپ ─────────────────────────────────────────────────────────────
# ⚠️ دامپ رمزنشده است. باید **خارج از همین سرور** کپی شود، وگرنه بکاپ
#    نیست (بند ۴ SECURITY.md). و Restore آن ماهانه تست شود.
BACKUP_DIR=./backup
